# Copy this file to ".env" and adjust values as needed.
# All variables are optional; sensible defaults are used when unset.

# SQLite database file location (default: ./certificates.db)
# DATABASE_URL=sqlite:///./certificates.db

# Directory where generated PDFs and ZIP files are stored (default: ./output)
# OUTPUT_DIR=./output

# Public base URL embedded inside the verification QR code on each
# certificate. Set this to the host where this API is reachable from a phone
# (e.g. your LAN IP or deployed domain) so scanning the QR actually works.
# Do NOT leave this as "localhost" for real use: a phone resolves localhost
# to itself. Default (when unset): http://localhost:8000
# CERTIFICATE_VERIFY_BASE_URL=https://certs.example.com

# Deprecated alias for CERTIFICATE_VERIFY_BASE_URL (still supported).
# PUBLIC_BASE_URL=http://localhost:8000
